# QQ Bot 启动配置
# 把这个文件复制为 .env，然后填入你的 GitHub Token

# 代理模式：true=走 Hermes 内置 Copilot，false=直接走 GitHub Copilot API
QQBOT_USE_HERMES=false

# 走 Hermes 时，令牌请写在 ~/.hermes/.env（COPILOT_GITHUB_TOKEN / GITHUB_TOKEN 等）
# 走直连 Copilot 时，下面这两个会生效
GITHUB_TOKEN=你的token填这里
QQBOT_COPILOT_BASE_URL=https://api.githubcopilot.com

# GPT-SoVITS（姐姐发 QQ 语音，不用微软 Edge TTS）
# 先在本机跑：python api_v2.py -a 127.0.0.1 -p 9880
# QQBOT_SOVITS_URL=http://host.docker.internal:9880/tts
# QQBOT_SOVITS_REF_AUDIO=/Users/tciuser1/qqbot/astrbot/data/plugin_data/astrbot_plugin_oneesan/sovits/ref.wav
# QQBOT_SOVITS_PROMPT_TEXT=参考音频里说的那句话
# QQBOT_SOVITS_PROMPT_LANG=zh
# QQBOT_SOVITS_TEXT_LANG=zh
# QQBOT_SOVITS_SPEED=1.0
